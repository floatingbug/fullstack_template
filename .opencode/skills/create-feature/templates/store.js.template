import { defineStore } from 'pinia';
import { load__Name__, load__Names__ } from '../services/__name__Service.js';

export const use__Name__Store = defineStore('__name__', {
  state: () => ({
    item: null,
    items: [],
    loading: false,
    error: null,
    // TODO: veränderliche Werte der UI, z. B. Eingaben
  }),
  actions: {
    async fetchOne(id) {
      this.loading = true;
      this.error = null;
      try {
        this.item = await load__Name__(id);
      } catch (e) {
        this.error = e;
      } finally {
        this.loading = false;
      }
    },
    async fetchAll() {
      this.loading = true;
      this.error = null;
      try {
        this.items = await load__Names__();
      } catch (e) {
        this.error = e;
      } finally {
        this.loading = false;
      }
    },
  },
});
