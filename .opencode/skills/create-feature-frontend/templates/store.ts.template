import { defineStore } from 'pinia'

import type { __Name__ } from '@/shared/api/types'
import { load__Name__, load__Names__ } from '../services/__name__Service'

interface __Name__State {
  item: __Name__ | null
  items: __Name__[]
  loading: boolean
  errorKey: string | null
}

export const use__Name__Store = defineStore('__name__', {
  state: (): __Name__State => ({
    item: null,
    items: [],
    loading: false,
    errorKey: null,
  }),

  actions: {
    async fetchOne(id: string): Promise<void> {
      this.loading = true
      this.errorKey = null

      try {
        this.item = await load__Name__(id)
      } catch {
        this.errorKey = '__name__.errors.load'
      } finally {
        this.loading = false
      }
    },

    async fetchAll(): Promise<void> {
      this.loading = true
      this.errorKey = null

      try {
        this.items = await load__Names__()
      } catch {
        this.errorKey = '__name__.errors.load'
      } finally {
        this.loading = false
      }
    },
  },
})
