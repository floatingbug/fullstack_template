{
  "name": "backendboilerplate",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run bundle:api && concurrently \"npm:dev:server\" \"npm:dev:api-watch\"",
    "dev:server": "tsx watch main.ts",
    "dev:api-watch": "chokidar \"../contracts/api/**/*.{yaml,yml}\" -c \"npm run bundle:api\"",
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "node --import tsx --test \"test/**/*.ts\"",
    "bundle:api": "redocly bundle ../contracts/api/openapi.yaml --dereferenced -o ../contracts/openapi.bundled.yaml",
    "pretest": "npm run bundle:api",
    "prebuild": "npm run bundle:api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "nodemailer": "^8.0.5",
    "pino": "^10.1.0",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/validator": "^13.15.10",
    "chokidar": "^6.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
